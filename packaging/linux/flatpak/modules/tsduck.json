{
  "name": "tsduck",
  "buildsystem": "simple",
  "build-options": {
    "env": {
      "NODEKTEC": "1", "NODTAPI": "1", "NOHIDES": "1", "NOVATEK": "1",
      "NOCURL": "1", "NOPCSC": "1", "NOOPENSSL": "1", "NOZLIB": "1",
      "NOSRT": "1", "NORIST": "1", "NOJAVA": "1", "NOPYTHON": "1",
      "NOEDITLINE": "1", "NOGITHUB": "1", "NODOC": "1", "NOTEST": "1", "NOSTATIC": "1",
      "SYSPREFIX": "/app", "USRLIBDIR": "/app/lib", "DEBUG": ""
    }
  },
  "build-commands": [
    "make -C src/libtscore -j4",
    "make -C src/libtsduck -j4",
    "make -C src/libtscore install-tools install-devel",
    "make -C src/libtsduck install-tools install-devel",
    "install -Dm0644 LICENSE.txt /app/share/licenses/tsduck/LICENSE.txt",
    "install -Dm0644 OTHERS.txt /app/share/licenses/tsduck/OTHERS.txt"
  ],
  "sources": [
    {
      "type": "git",
      "url": "https://github.com/tsduck/tsduck.git",
      "commit": "f3e026e927c5b054649ff4e5d5a6ba2eabc1ce8c"
    },
    {
      "type": "patch",
      "path": "patches/tsduck-no-web.patch"
    }
  ]
}
